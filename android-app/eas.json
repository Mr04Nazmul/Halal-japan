{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-ads": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "HALAL_VARIANT": "ads"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
